# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=speculative-tool-executor
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys.
# Generate a key with: uv run speculative-tool-executor generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Agentic kit. Tests, demo and bench run offline and never need a key.
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5
APP_LLM_EFFORT=high
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_REFUSAL_FALLBACK=true
APP_BUDGET_MAX_STEPS=50
APP_BUDGET_MAX_TOKENS=200000
APP_BUDGET_MAX_USD=1.0

# Speculation. APP_SPECULATION_ENABLED=false is the kill switch; the disabled-tools list is a
# comma-separated per-tool override. Both take effect without a deploy.
APP_SPECULATION_ENABLED=true
APP_SPECULATION_TOP_K=2
APP_SPECULATION_MAX_IN_FLIGHT=4
APP_SPECULATION_DISABLED_TOOLS=
APP_SPECULATION_MIN_PROBABILITY=0.05
APP_SPECULATION_LATENCY_VALUE_USD_PER_SECOND=0.01
APP_SPECULATION_BUDGET_USD=0.5
APP_SPECULATION_MAX_WASTE_RATIO=0.10

APP_DATA_DIR=var
